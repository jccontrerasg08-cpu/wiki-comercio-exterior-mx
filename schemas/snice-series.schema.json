{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jccontrerasg08-cpu/wiki-comercio-exterior-mx/schemas/snice-series.schema.json",
  "title": "SNICE logical document series",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_url", "generated_at", "index_sha256", "series_count", "series"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "generated_at": {"type": "string", "format": "date-time"},
    "index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "series_count": {"type": "integer", "minimum": 0},
    "series": {"type": "array", "items": {"$ref": "#/$defs/series"}}
  },
  "$defs": {
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_dataset_id", "family", "category", "period_year", "period_month", "documents"],
      "properties": {
        "logical_dataset_id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "period_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
        "period_month": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
        "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "filename", "source_url", "last_modified", "bytes", "sha256", "version", "is_replacement", "is_backfill"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^snice-url-[0-9a-f]{64}$"},
        "filename": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "last_modified": {"type": "string", "minLength": 19},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "integer", "minimum": 1},
        "is_replacement": {"type": "boolean"},
        "is_backfill": {"type": "boolean"}
      }
    }
  }
}
