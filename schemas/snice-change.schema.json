{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jccontrerasg08-cpu/wiki-comercio-exterior-mx/schemas/snice-change.schema.json",
  "title": "SNICE snapshot change events",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_url", "generated_at", "changes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "generated_at": {"type": "string", "format": "date-time"},
    "changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    }
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "logical_dataset_id", "detected_at", "rows_added", "rows_removed", "rows_modified"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "logical_dataset_id": {"type": "string", "minLength": 1},
        "detected_at": {"type": "string", "format": "date-time"},
        "from_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "to_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "rows_added": {"type": "integer", "minimum": 0},
        "rows_removed": {"type": "integer", "minimum": 0},
        "rows_modified": {"type": "integer", "minimum": 0}
      }
    }
  }
}
