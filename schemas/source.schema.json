{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jccontrerasg08-cpu/wiki-comercio-exterior-mx/schemas/source.schema.json",
  "title": "Official source record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "jurisdiction", "title", "url", "authority", "evidence_class", "allowed_hosts", "media_types", "harvest"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "jurisdiction": {"type": "string", "pattern": "^(?:[A-Z]{3}|GLOBAL)$"},
    "title": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "note_id": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "authority": {"type": "string", "minLength": 1},
    "evidence_class": {
      "enum": ["primary_legal", "official_consolidated", "official_administrative", "official_data", "international_official", "catalog_only", "official_statistics", "official_operational", "intergovernmental", "secondary"]
    },
    "instrument_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "instrument_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "publication_date": {"type": "string", "format": "date"},
    "content_valid_from": {"type": "string", "format": "date"},
    "content_valid_to": {"type": ["string", "null"], "format": "date"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "allowed_hosts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "media_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "harvest": {"type": "boolean"},
    "cadence_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "archive": {"$ref": "#/$defs/archive"},
    "probe": {"$ref": "#/$defs/probe"}
  },
  "allOf": [
    {
      "not": {"required": ["instrument_id", "instrument_ids"]}
    },
    {
      "if": {"properties": {"harvest": {"const": true}}, "required": ["harvest"]},
      "then": {"required": ["cadence_days", "probe"]}
    },
    {
      "if": {"properties": {"evidence_class": {"const": "official_consolidated"}}, "required": ["evidence_class"]},
      "then": {"required": ["instrument_id", "publication_date", "content_valid_from"]}
    }
  ],
  "$defs": {
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["local_git", "release_asset", "external_only"]},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "release_tag": {"type": "string", "minLength": 1},
        "asset_name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "mime_type": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "local_git"}}, "required": ["status"]},
          "then": {"required": ["path", "sha256", "size_bytes", "mime_type", "captured_at"]}
        },
        {
          "if": {"properties": {"status": {"const": "release_asset"}}, "required": ["status"]},
          "then": {"required": ["release_tag", "asset_name", "sha256", "size_bytes", "mime_type", "captured_at"]}
        },
        {
          "if": {"properties": {"status": {"const": "external_only"}}, "required": ["status"]},
          "then": {"required": ["reason"]}
        }
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "expected_status", "min_bytes"],
      "properties": {
        "method": {"enum": ["GET", "HEAD"]},
        "expected_status": {"type": "array", "items": {"type": "integer", "minimum": 100, "maximum": 599}, "minItems": 1, "uniqueItems": true},
        "min_bytes": {"type": "integer", "minimum": 0},
        "max_bytes": {"type": "integer", "minimum": 1},
        "expected_title": {"type": "string", "minLength": 1},
        "expected_path": {"type": "string", "pattern": "^/"},
        "reject_if_contains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
